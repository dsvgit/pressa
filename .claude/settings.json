{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build*)",
      "Bash(cargo check*)",
      "Bash(cargo test*)",
      "Bash(cargo clippy*)",
      "Bash(cargo fmt*)",
      "Bash(cargo tree*)",
      "Bash(cargo metadata*)",
      "Bash(just ci*)",
      "Bash(just test*)",
      "Bash(just lint*)",
      "Bash(just fmt*)",
      "Bash(just check*)",
      "Bash(just validate*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git ls-files*)",
      "Bash(git branch --show-current*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ci-check.sh",
            "timeout": 300,
            "statusMessage": "just ci"
          }
        ]
      }
    ]
  }
}
